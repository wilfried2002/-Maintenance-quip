# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Gabarit de configuration PRODUCTION — copier vers .env sur le serveur    ║
# ║ puis générer la clé :  php artisan key:generate                          ║
# ║ Le .env réel n'est jamais committé (déjà ignoré par .gitignore).          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

APP_NAME="Maintenance Equipement Industriel"
APP_ENV=production
APP_KEY=
# Ne JAMAIS activer le debug en production : les pages d'erreur exposent la
# configuration, les chemins du serveur et des morceaux de .env.
APP_DEBUG=false
APP_URL=https://votre-domaine.example

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maintenance_equipement
DB_USERNAME=maintenance
DB_PASSWORD=

# Sessions : site servi en HTTPS uniquement → cookie sécurisé (refusé en HTTP
# clair par le navigateur) + HttpOnly (défaut) + SameSite lax (défaut).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ⚠ OBLIGATOIRE : la vérification d'e-mail bloque l'accès tant qu'elle n'est pas
# faite. Avec MAIL_MAILER=log, aucun nouveau compte ne peut vérifier son adresse
# (connexion impossible). Renseigner un vrai SMTP (fournisseur, OVH, Gmail…).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.votre-fournisseur.example
MAIL_PORT=587
MAIL_USERNAME=no-reply@votre-domaine.example
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@votre-domaine.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── Rappels post-déploiement (voir DEPLOYMENT_CHECKLIST.md) ────────────────
#  • Cron du planificateur (génère la maintenance préventive, les alertes,
#    les indicateurs — sans lui, RIEN ne se déclenche automatiquement) :
#       * * * * * cd /var/www/html && php artisan schedule:run >> /dev/null 2>&1
#  • php artisan migrate --force
#  • php artisan storage:ensure-link
#  • php artisan config:cache && php artisan route:cache
#  • chown -R www-data:www-data storage bootstrap/cache
